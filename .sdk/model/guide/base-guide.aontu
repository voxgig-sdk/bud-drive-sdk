      op: list: method: *GET
    }
    path: "/drive-api/v2/segments/{segment_id}/criteria": {
      op: load: method: *GET
    }
    path: "/drive-api/v2/segments/{segment_id}/criteria/active-options": {
      op: load: method: *GET
    }
    path: "/drive-api/v2/segments/{segment_id}/criteria/run": {
      op: create: method: *POST
    }
